# Copy this file to .env and adjust as needed.
# For production (GitHub Pages), set VITE_API_BASE_URL and VITE_WS_BASE_URL
# as GitHub Actions secrets (Settings → Secrets → Actions) so they are
# injected at build time by the deploy-frontend.yml workflow.

# Base URL of your FastAPI backend deployed on Render.
# Local dev:  http://localhost:8000
# Production: https://<your-app>.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# Base URL for the WebSocket connection (same host as API, ws:// or wss://).
# Local dev:  ws://localhost:8000
# Production: wss://<your-app>.onrender.com
VITE_WS_BASE_URL=ws://localhost:8000

# "true"  -> the app runs entirely against realistic in-memory mock data.
#            Use this today: your backend (as of Task 5) doesn't yet implement
#            auth, /scans listing, /vulnerabilities, /threat-logs, or /admin/*,
#            so Mock Mode is what makes the web app fully clickable right now.
# "false" -> the app calls the real FastAPI backend at VITE_API_BASE_URL for
#            every request. Flip this once your backend implements the full
#            Task 2 API contract.
VITE_USE_MOCK=true
